# maxgame-template-server — configuration template.
# PLACEHOLDER VALUES ONLY. Copy to `.env` and fill in real values there;
# `.env` is gitignored and must never be committed.

APP_ENV=development
HOST=0.0.0.0
# Pick the next free port before renaming this service — see
# `maxion-admin-guard/contract/PLATFORM.md` §3.1's port table. Do not ship a
# real service on 8097; it is the template's placeholder only.
PORT=8097

# ── Postgres ──────────────────────────────────────────────────────────
DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres
DATABASE_MAX_CONNECTIONS=10

# ── Admin IdP (this service is a pure resource server) ────────────────
# Point these at maxgame-admin-auth-server (or, before its cutover,
# web-platform-backend) — no code change either way.
ADMIN_IDP_BASE_URL=https://api.maxion.game
# Expected `iss` claim. Byte-compared — not derived from the base URL.
ADMIN_JWT_ISSUER=maxion-platform.maxion.game
# Defaults to ADMIN_IDP_BASE_URL + /.well-known/jwks.json when unset. Must be
# https in every deployed environment (staging, uat, production): the
# signing keys arrive over it, so a plaintext fetch is a token-forgery path.
ADMIN_JWKS_URL=
# Path of the introspection endpoint, relative to ADMIN_IDP_BASE_URL.
# Defaults to /api/v1/oauth/introspect.
ADMIN_INTROSPECT_PATH=
ADMIN_INTROSPECT_API_KEY=REPLACE_WITH_ADMIN_INTROSPECT_API_KEY

# ── Gateway readiness (PLATFORM.md §5) ─────────────────────────────────
# Optional. Empty = mounted at root (today's behaviour). Set only when
# deploying behind the shared ingress path prefix.
BASE_PATH=

# ── HTTP ──────────────────────────────────────────────────────────────
# Comma-separated browser origins allowed to call this service.
# REQUIRED outside development — staging, uat and production all refuse to
# boot with this empty or containing a literal `*`.
CORS_ALLOWED_ORIGINS=http://localhost:5173
